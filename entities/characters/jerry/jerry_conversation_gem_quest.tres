[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://vhxlivcseese"]

[ext_resource type="Script" uid="uid://c4ge5f0amdtmm" path="res://features/dialogue/dialogue_conversation.gd" id="1_conversation"]
[ext_resource type="Script" uid="uid://cglee7piovdkl" path="res://features/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cf55a2xa12rru" path="res://features/dialogue/dialogue_choice.gd" id="3_choice"]
