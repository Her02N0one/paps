[sub_resource type="Resource" id="ChoiceReturn"]
script = ExtResource("3_choice")
text = "Let's talk about something else."
target_conversation_id = &"main"

[sub_resource type="Resource" id="NodeGemQuest"]
script = ExtResource("2_node")
id = &"start"
speaker = "Jerry"
text = "Did you find out what [wave amp=40.0 freq=5.0][color=#FFD700]that strange gem[/color][/wave] actually does?!"
expression = &"surprised"
choices = Array[ExtResource("3_choice")]([SubResource("ChoiceReturn")])

[resource]
script = ExtResource("1_conversation")
id = &"jerry_gem_quest"
entry_node_id = &"start"
nodes = Array[ExtResource("2_node")]([SubResource("NodeGemQuest")])
