; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="paps"
run/main_scene="res://core/bootstrap/root_context.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://b676q0vvc22c8"

[autoload]

MessageBus="*res://core/events/message_bus.gd"
TimeManager="*res://core/time/time_manager.gd"
ServiceRegistry="*res://core/bootstrap/service_registry.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

