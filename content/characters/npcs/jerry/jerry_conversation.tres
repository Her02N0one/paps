text = "Goodbye."
next_node_id = &"goodbye_warned"
conditions = Array[ExtResource("3_toghu")]([SubResource("CondToldJerry")])

[sub_resource type="Resource" id="EffectMet"]
script = ExtResource("4_effect")
flag = &"met_jerry"

[sub_resource type="Resource" id="NodeStart"]
script = ExtResource("2_node")
id = &"start"
speaker = "Jerry"
text = "[wave amp=25.0 freq=4.0]What's love Doctor Do-[/wave]
[i]Doctor Do-little?[/i]"
choices = Array[ExtResource("3_choice")]([SubResource("ChoiceIdentity"), SubResource("ChoiceWork"), SubResource("Resource_g4v7s"), SubResource("ChoiceQuestGraph"), SubResource("ChoiceLeave"), SubResource("Resource_5tb7a"), SubResource("ChoiceLeavePostGem")])
effects = Array[ExtResource("4_pxv5l")]([SubResource("EffectMet")])

[sub_resource type="Resource" id="Resource_0oncu"]
script = ExtResource("2_node")
id = &"identity"
speaker = "Jerry"
text = "I'm [b]Jerry.[/b] 
[color=#FFD700]Jerry Smith.[/color]"
expression = &"torso"

[sub_resource type="Resource" id="Resource_fn4oh"]
script = ExtResource("2_node")
id = &"work"
speaker = "Jerry"
text = "I, [i]Jerry Smith,[/i] am proudly... [shake rate=15.0 level=5.0]unemployed.[/shake]"
expression = &"surprised"

[sub_resource type="Resource" id="Resource_d0u6y"]
script = ExtResource("2_node")
id = &"gem"
speaker = "Jerry"
text = "[shake rate=25.0 level=10.0]Oh great, now you're cursed too...[/shake]
I told you not to touch that!"
expression = &"surprised"
next_node_id = &"gem2"

[sub_resource type="Resource" id="Resource_il7qn"]
script = ExtResource("3_choice")
text = "Who's Beth?"
next_node_id = &"wife"

[sub_resource type="Resource" id="Resource_ub8vl"]
script = ExtResource("3_choice")
text = "Okay..."

[sub_resource type="Resource" id="Resource_7numd"]
script = ExtResource("10_ub8vl")
id = &"curse_away"
display_name = "CurseAway"
description = "Some weird anti-curse device"
icon = ExtResource("10_il7qn")
