[sub_resource type="Resource" id="EffectToldAboutGem"]
script = ExtResource("4_effect")
flag = &"told_jerry_about_gem"

[sub_resource type="Resource" id="Resource_3gngh"]
script = ExtResource("2_node")
id = &"gem2"
speaker = "Jerry"
text = "Here, take this [color=#87CEEB]CurseAway[/color]. 
[color=#FFD700]Beth's dad[/color] made them."
expression = &"torso"
choices = Array[ExtResource("3_choice")]([SubResource("Resource_il7qn"), SubResource("Resource_ub8vl")])
effects = Array[ExtResource("4_pxv5l")]([SubResource("Resource_fcnqv"), SubResource("EffectToldAboutGem")])

[sub_resource type="Resource" id="Resource_eiemq"]
script = ExtResource("2_node")
id = &"wife"
speaker = "Jerry"
text = "She's...
[rainbow freq=0.8 sat=0.8 val=0.9]*mah wife.*[/rainbow]"
expression = &"surprised"

[sub_resource type="Resource" id="Resource_toghu"]
script = ExtResource("2_node")
id = &"goodbye"
speaker = "Jerry"
text = "Whatever you do, [wave amp=30.0 freq=4.0]don't go behind[/wave] that weird obelisk."
expression = &"torso"

[sub_resource type="Resource" id="NodeGoodbyeWarned"]
script = ExtResource("2_node")
id = &"goodbye_warned"
speaker = "Jerry"
text = "I'm sure it'll be fine.
[i]Probably...[/i]"
expression = &"surprised"

