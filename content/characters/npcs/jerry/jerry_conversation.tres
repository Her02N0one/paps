[sub_resource type="Resource" id="ChoiceIdentity"]
script = ExtResource("3_choice")
text = "Who are you?"
next_node_id = &"identity"

[sub_resource type="Resource" id="ChoiceWork"]
script = ExtResource("3_choice")
text = "What do you do?"
next_node_id = &"work"

[sub_resource type="Resource" id="Resource_yf5fn"]
script = ExtResource("7_il7qn")
item = ExtResource("6_o8bvo")

[sub_resource type="Resource" id="CondNotToldJerry"]
script = ExtResource("8_flagcond")
flag = &"told_jerry_about_gem"
expected_value = false

[sub_resource type="Resource" id="Resource_g4v7s"]
script = ExtResource("3_choice")
text = "[Show Strange Gem] What is this?"
next_node_id = &"gem"
conditions = Array[ExtResource("3_toghu")]([SubResource("Resource_yf5fn"), SubResource("CondNotToldJerry")])

[sub_resource type="Resource" id="CondToldJerry"]
script = ExtResource("8_flagcond")
flag = &"told_jerry_about_gem"

[sub_resource type="Resource" id="ChoiceQuestGraph"]
script = ExtResource("3_choice")
text = "Ask about the Gem's secret curse..."
conditions = Array[ExtResource("3_toghu")]([SubResource("CondToldJerry")])
target_conversation_id = &"gem_quest"

[sub_resource type="Resource" id="ChoiceLeave"]
script = ExtResource("3_choice")
text = "Goodbye."
next_node_id = &"goodbye"
conditions = Array[ExtResource("3_toghu")]([SubResource("CondNotToldJerry")])

[sub_resource type="Resource" id="Resource_cjxld"]
