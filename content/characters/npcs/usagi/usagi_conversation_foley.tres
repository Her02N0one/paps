[sub_resource type="Resource" id="Resource_n08tw"]
script = ExtResource("2_7kjuc")
id = &"hello"
speaker = "Usagi"
text = "Hello there! I'm [wave amp=30.0 freq=5.0][color=#FF69B4]Usagi[/color][/wave]!
I'm the [shake rate=20.0 level=5 connected=1]master[/shake] [wave amp=25.0 freq=4.0]Foley Artist[/wave]!"
choices = Array[ExtResource("3_g7sd6")]([SubResource("Resource_m6rps"), SubResource("Resource_ri6b7")])
metadata/_custom_type_script = "uid://cglee7piovdkl"

[sub_resource type="Resource" id="Resource_ov8qe"]
script = ExtResource("2_7kjuc")
id = &"fu"
speaker = "Usagi"
text = "[shake rate=40.0 level=10 connected=1][color=#FF0000]Alright well fuck you chud, get bent.[/color][/shake]"
expression = &"fat"
metadata/_custom_type_script = "uid://cglee7piovdkl"

[sub_resource type="Resource" id="Resource_jkr81"]
script = ExtResource("3_g7sd6")
text = "Absolutely"
next_node_id = &"laser_foley"
metadata/_custom_type_script = "uid://cf55a2xa12rru"

[sub_resource type="Resource" id="Resource_omqb8"]
script = ExtResource("3_g7sd6")
text = "Hell no"
next_node_id = &"fu"
metadata/_custom_type_script = "uid://cf55a2xa12rru"

[sub_resource type="Resource" id="Resource_x453x"]
script = ExtResource("2_7kjuc")
id = &"foley"
speaker = "Usagi"
text = "Yes, [wave amp=20.0 freq=6.0]Foley[/wave]!
I've [rainbow freq=0.5 sat=0.8 val=1.0]perfected[/rainbow] the art of sound.
Do you want to hear my [tornado radius=3.0 freq=2.0][color=#00FFFF]laser[/color][/tornado] sound effect?"
choices = Array[ExtResource("3_g7sd6")]([SubResource("Resource_jkr81"), SubResource("Resource_omqb8")])
metadata/_custom_type_script = "uid://cglee7piovdkl"

[sub_resource type="Resource" id="Resource_6c67f"]
script = ExtResource("3_g7sd6")
text = "That was terrible"
next_node_id = &"terrible"
metadata/_custom_type_script = "uid://cf55a2xa12rru"

[sub_resource type="Resource" id="Resource_iyy3j"]
