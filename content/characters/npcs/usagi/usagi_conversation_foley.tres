[sub_resource type="Resource" id="Resource_lxdxb"]
script = ExtResource("2_7kjuc")
id = &"terrible"
speaker = "Usagi"
text = "I knew it...
[shake rate=10.0 level=3 connected=1]my family was right...[/shake]"
